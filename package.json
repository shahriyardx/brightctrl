{
  "name": "brightctrl",
  "version": "0.0.9",
  "description": "A lightweight DDC/CI monitor brightness controller for Linux",
  "type": "module",
  "bin": {
    "brightctrl": "dist/index.js",
    "bctrl": "dist/index.js",
    "bc": "dist/index.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "dev": "bun --watch src/index.tsx",
    "build": "bun build src/index.tsx --outfile dist/index.js --target node --format esm --external '@types/react' --banner '#!/usr/bin/env node' && chmod +x dist/index.js",
    "prepublishOnly": "bun run build",
    "lint": "biome check src/",
    "format": "biome check --write src/",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "ink": "^7.0.3",
    "react": "^19.2.6",
    "smol-toml": "^1.6.1"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.15",
    "@types/node": "^25.8.0",
    "@types/react": "^19.2.14",
    "react-devtools-core": "^7.0.1",
    "typescript": "^6.0.3"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/shahriyardx/brightctrl.git"
  },
  "homepage": "https://github.com/shahriyardx/brightctrl",
  "keywords": [
    "brightness",
    "ddc-ci",
    "ddcutil",
    "monitor",
    "tui",
    "ink",
    "waybar"
  ],
  "license": "MIT"
}
